# Required before starting the gateway.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ADMIN_PASSWORD=replace_with_a_strong_admin_password
VIEWER_PASSWORD=replace_with_a_read_only_password
WEBHOOK_TOKEN=replace_with_a_separate_random_webhook_secret

# Demo broker. Configure a private TLS broker for real devices.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_TELEMETRY_TOPIC=mixiplan/tuoicay_mx7k2/trangthai
MQTT_COMMAND_TOPIC=mixiplan/tuoicay_mx7k2/bom/set
MQTT_ACK_TOPIC=mixiplan/tuoicay_mx7k2/bom/ack

DATABASE_PATH=./data/mixiplan.sqlite3
# Keep the local API bound to loopback unless deployed behind HTTPS/reverse proxy.
WEB_HOST=127.0.0.1
WEB_PORT=8000
